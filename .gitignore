# WordPress Theme - ConfiGamer
# .gitignore

# ================================
# ARQUIVOS DO SISTEMA
# ================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ================================
# EDITORES / IDEs
# ================================

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# PhpStorm / WebStorm
.idea/
*.iml

# Notepad++
*.bak

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-v][a-z]
[._]sw[a-p]

# ================================
# NODE / NPM (se usar Sass/Gulp)
# ================================

node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# ================================
# WORDPRESS ESPECÍFICO
# ================================

# Arquivos de compilação (se usar)
*.min.css
*.min.js
*.map

# Logs
*.log
error_log
debug.log

# Cache
*.cache
.sass-cache/

# Backups
*.backup
*.bak
*.old

# ================================
# DESENVOLVIMENTO
# ================================

# Rascunhos / Testes
test.php
temp/
tmp/
draft/
_notes/

# Arquivos de configuração local
.env
.env.local
config.local.php

# ================================
# ARQUIVOS TEMPORÁRIOS
# ================================

*.tmp
*.swp
*.swo
*~

# ================================
# COMPRESSÃO
# ================================

*.zip
*.tar.gz
*.rar

# ================================
# OUTROS
# ================================

# Screenshots temporários (manter apenas o oficial)
screenshot-draft.png
screenshot-old.png
